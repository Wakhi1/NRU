# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# Session
SESSION_SECRET=secure-string-docsecure-user-session_secret

# Field-level encryption at rest (national ID, next-of-kin phone, bank account/tax number, TOTP
# secret) — AES-256 key, 32 bytes base64. Losing/rotating this makes existing encrypted values
# unreadable, so back it up like a credential, not like ordinary config.
ENCRYPTION_KEY=dFZjctt8q9w6+FaJcqefL4gMRJeem22/xbQt9Y6aoiE=

# Optional — TLS termination inside Node itself (PEM paths). Leave blank to serve plain HTTP,
# which is fine when a reverse proxy (nginx, IIS, a load balancer) terminates TLS in front of
# this process instead; set both to have this process serve HTTPS directly.
SSL_KEY_PATH=
SSL_CERT_PATH=

# Set true only when this process sits behind a reverse proxy that terminates TLS — lets Express
# trust the proxy's X-Forwarded-* headers so secure cookies and HSTS work correctly. Leave false
# (or unset) for a direct/standalone deployment, since trusting these headers from the open
# internet would let a client spoof its own scheme/IP.
TRUST_PROXY=false

# MySQL (XAMPP defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hris

# SMTP (used by src/platform/mailer.js)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=wakhiwakhi1@gmail.com
SMTP_PASS=
SMTP_FROM="NRU HRIS <no-reply@nru.org>"
