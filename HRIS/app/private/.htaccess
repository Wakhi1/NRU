# Defense in depth only — the app never generates a URL that points at this folder directly
# (uploaded files are served through /img and /uploads, which read from here but expose a
# different URL path — see the comments on IMG_DIR/UPLOAD_DIR in src/routes/branding.routes.js
# and src/routes/people.routes.js). This just makes sure a direct guess at the real path (e.g.
# /private/img/<filename>) is refused by the webserver instead of returning the raw encrypted
# file, on hosts where that would otherwise be served as a static file.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
