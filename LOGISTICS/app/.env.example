# Server
PORT=4200
NODE_ENV=development
APP_URL=http://localhost:4200

# Session
SESSION_SECRET=change-me-flms-session-secret

# MySQL (XAMPP defaults) — FLMS keeps its own standalone database, separate from the HRIS's.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flms

# HRIS integration (docs/INTEGRATION.md on the HRIS side) — FLMS never owns employee records or
# credentials. It pulls people/org/leave/certification data read-only via this API key, and
# delegates login/lockout/MFA to the HRIS entirely, exactly like SPTS does (scopes: employees:read,
# org:read, leave:read, certifications:read, timesheets:read, audit:create, identity:create,
# mfa:read, mfa:create). Issue this key from the HRIS's Integrations page — the "Fleet / logistics"
# preset pre-checks Employees/Org/Leave/Certifications read; add Identity:C and MFA:R+C manually
# since login delegation wasn't part of the original preset table.
HRIS_API_BASE=http://localhost:4000/api/v1/integration
HRIS_API_KEY=
